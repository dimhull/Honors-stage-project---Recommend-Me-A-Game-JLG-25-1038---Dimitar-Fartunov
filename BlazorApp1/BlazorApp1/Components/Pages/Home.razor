@page "/"
@rendermode InteractiveServer
@using BlazorApp1.Components.Models
@using BlazorApp1.Components.Service
@using BlazorApp1.Components.Services
@inject RawgApiService ApiService
@inject GameRecommendationService RecommendationService

<PageTitle>Game Recommender</PageTitle>

<div class="home-container">
    <header class="hero">
        <h1>Game Recommender</h1>
        <p>Find your next favorite game based on what you love</p>
    </header>

    <div class="search-section">
        <SearchBar OnGameSelect="HandleGameSelected" />
    </div>

    @if (selectedGame != null)
    {
        <section class="selected-game-section">
            <div class="selected-game-header">
                <h2>Selected Game</h2>
                <button @onclick="GoBackHome" class="back-btn">← Back to Home</button>
            </div>
            <div class="selected-game">
                <GameCard Game="selectedGame" />
            </div>

            @if (selectedGame.Tags.Any())
            {
                <div class="tag-filter-section">
                    <div class="tag-filter-header">
                        <h3>Narrow recommendations by tag</h3>
                        @if (requiredTagIds.Any())
                        {
                            <button class="clear-filter-btn" @onclick="ClearTagFilter">Clear filters</button>
                        }
                    </div>
                    <div class="tag-filter-chips">
                        @foreach (var tag in selectedGame.Tags)
                        {
                            <span class="filter-chip @(requiredTagIds.Contains(tag.Id) ? "active" : "")"
                                  @onclick="() => ToggleRequiredTag(tag)">
                                @tag.Name
                            </span>
                        }
                    </div>
                </div>
            }
        </section>
    }

    @if (isLoadingRecommendations)
    {
        <div class="loading">
            <div class="spinner">🔄</div>
            <p>Finding similar games...</p>
        </div>
    }

    @if (!isLoadingRecommendations && selectedGame != null && !recommendations.Any() && requiredTagIds.Any())
    {
        <div class="no-filter-results">
            <p>No games match all selected tags. Try removing some filters.</p>
        </div>
    }

    @if (recommendations.Any())
    {
        <section class="recommendations-section">
            <h2>Recommended Games@(requiredTagIds.Any() ? $" (filtered by {requiredTagIds.Count} tag{(requiredTagIds.Count > 1 ? "s" : "")})" : "")</h2>
            <div class="games-grid">
                @foreach (var rec in recommendations)
                {
                    <GameCard Game="rec.Game"
                              ShowSimilarityScore="true"
                              SimilarityScore="rec.SimilarityScore"
                              OnClick="HandleGameSelected" />
                }
            </div>
        </section>
    }

    @if (popularGames.Any() && !recommendations.Any() && selectedGame == null)
    {
        <section class="popular-section">
            <h2>Popular Games</h2>
            <div class="games-grid">
                @foreach (var game in popularGames)
                {
                    <GameCard Game="game" OnClick="HandleGameSelected" />
                }
            </div>
        </section>
    }
</div>

@code {


    private Game? selectedGame;
    private List<GameRecommendation> recommendations = new();
    private List<Game> popularGames = new();
    private bool isLoadingRecommendations = false;
    private HashSet<int> requiredTagIds = new();

    protected override async Task OnInitializedAsync()
    {
        popularGames = await ApiService.GetPopularGamesAsync(20);

        Console.WriteLine($"Popular games (filtered & English tags): {popularGames.Count}");
    }

    private void GoBackHome()
    {
        selectedGame = null;
        recommendations.Clear();
        requiredTagIds.Clear();
    }

    private async Task ToggleRequiredTag(Tag tag)
    {
        if (requiredTagIds.Contains(tag.Id))
            requiredTagIds.Remove(tag.Id);
        else
            requiredTagIds.Add(tag.Id);

        await RefreshRecommendations();
    }

    private async Task ClearTagFilter()
    {
        requiredTagIds.Clear();
        await RefreshRecommendations();
    }

    private async Task RefreshRecommendations()
    {
        if (selectedGame == null) return;
        isLoadingRecommendations = true;
        StateHasChanged();
        var filter = requiredTagIds.Count > 0 ? new HashSet<int>(requiredTagIds) : null;
        recommendations = await RecommendationService.GetRecommendationsAsync(selectedGame, 12, filter);
        isLoadingRecommendations = false;
    }

    private async Task HandleGameSelected(Game game)
    {
        selectedGame = game;
        recommendations.Clear();
        requiredTagIds.Clear();
        isLoadingRecommendations = true;

        try
        {
            var fullGame = await ApiService.GetGameByIdAsync(game.Id);

            if (fullGame != null)
            {
                Console.WriteLine($"Loaded game: {fullGame.Name}");
                Console.WriteLine($"Tags count: {fullGame.Tags?.Count ?? 0}");

                selectedGame = fullGame;
                recommendations = await RecommendationService.GetRecommendationsAsync(fullGame, 12);

                Console.WriteLine($"Got {recommendations.Count} recommendations");
            }
        }
        finally
        {
            isLoadingRecommendations = false;
        }
    }
}