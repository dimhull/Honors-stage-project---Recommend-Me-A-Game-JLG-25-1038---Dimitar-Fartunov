@using BlazorApp1.Components.Models
@using BlazorApp1.Components.Services
@inject WishlistService WishlistService
@inject AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<div class="game-card" @onclick="OnCardClick">
    <div class="game-image">
        @if (!string.IsNullOrEmpty(Game.BackgroundImage))
        {
            <img src="@Game.BackgroundImage" alt="@Game.Name" />
        }
        else
        {
            <div class="no-image">No Image</div>
        }

        @if (AuthService.IsAuthenticated)
        {
            <button class="wishlist-btn @(isInWishlist ? "active" : "")"
                    @onclick="ToggleWishlist"
                    @onclick:stopPropagation="true">
                @(isInWishlist ? "❤️" : "🤍")
            </button>
        }
    </div>

    <div class="game-info">
        <h3 class="game-title">@Game.Name</h3>
        <div class="game-rating">
            <span class="star">⭐</span>
            <span>@Game.Rating.ToString("F2")</span>
        </div>
        @if (Game.Released.HasValue)
        {
            <div class="game-released">
                Released: @Game.Released.Value.ToString("MMM dd, yyyy")
            </div>
        }
        @{
            var platforms = GetDisplayPlatforms();
            var steamUrl = GetSteamUrl();
        }
        @if (platforms.Any())
        {
            <div class="game-platforms">
                @foreach (var p in platforms)
                {
                    <span class="platform-badge">@p</span>
                }
            </div>
        }
        <div class="game-tags">
            @foreach (var tag in Game.Tags.Take(4))
            {
                <span class="tag">@tag.Name</span>
            }
            @if (Game.Tags.Count > 4)
            {
                <span class="tag more clickable" @onclick="ShowAllTags" @onclick:stopPropagation="true">
                    +@(Game.Tags.Count - 4) more
                </span>
            }
        </div>
        @if (steamUrl != null)
        {
            <a href="@steamUrl" target="_blank" rel="noopener noreferrer"
               class="steam-link" @onclick:stopPropagation="true">
                🛒 Buy on Steam
            </a>
        }
        @if (ShowSimilarityScore && SimilarityScore.HasValue)
        {
            <div class="similarity-score">
                Match: @((SimilarityScore.Value * 100).ToString("F0"))%
            </div>
        }
    </div>
</div>

@if (showTagsModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>All Tags for @Game.Name</h3>
                <button class="close-btn" @onclick="CloseModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="all-tags">
                    @foreach (var tag in Game.Tags)
                    {
                        <span class="tag">@tag.Name</span>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Game Game { get; set; } = null!;

    [Parameter]
    public EventCallback<Game> OnClick { get; set; }

    [Parameter]
    public bool ShowSimilarityScore { get; set; } = false;

    [Parameter]
    public double? SimilarityScore { get; set; }

    private bool showTagsModal = false;
    private bool isInWishlist = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            isInWishlist = await WishlistService.IsInWishlistAsync(Game.Id);
        }

        WishlistService.OnWishlistChanged += HandleWishlistChanged;
    }

    private async Task OnCardClick()
    {
        await OnClick.InvokeAsync(Game);
    }

    private List<string> GetDisplayPlatforms()
    {
        if (Game.Platforms == null || !Game.Platforms.Any()) return new List<string>();

        var result = new HashSet<string>();
        foreach (var pi in Game.Platforms)
        {
            var slug = pi.Platform?.Slug ?? "";
            if (slug == "pc") result.Add("PC");
            else if (slug == "macos") result.Add("Mac");
            else if (slug == "linux") result.Add("Linux");
            else if (slug.StartsWith("playstation")) result.Add("PlayStation");
            else if (slug.StartsWith("xbox")) result.Add("Xbox");
            else if (slug == "nintendo-switch") result.Add("Switch");
            else if (slug == "ios" || slug == "android") result.Add("Mobile");
        }
        return result.OrderBy(p => p).ToList();
    }

    private string? GetSteamUrl()
    {
        if (Game.Stores == null) return null;
        var steam = Game.Stores.FirstOrDefault(s => s.Store?.Slug == "steam");
        if (steam == null) return null;
        return !string.IsNullOrEmpty(steam.Url)
            ? steam.Url
            : $"https://store.steampowered.com/search/?term={Uri.EscapeDataString(Game.Name)}";
    }

    private void ShowAllTags()
    {
        showTagsModal = true;
    }

    private void CloseModal()
    {
        showTagsModal = false;
    }

    private async Task ToggleWishlist()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (isInWishlist)
        {
            await WishlistService.RemoveFromWishlistAsync(Game.Id);
        }
        else
        {
            await WishlistService.AddToWishlistAsync(Game);
        }

        isInWishlist = !isInWishlist;
    }

    private async void HandleWishlistChanged()
    {
        if (AuthService.IsAuthenticated)
        {
            isInWishlist = await WishlistService.IsInWishlistAsync(Game.Id);
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        WishlistService.OnWishlistChanged -= HandleWishlistChanged;
    }
}