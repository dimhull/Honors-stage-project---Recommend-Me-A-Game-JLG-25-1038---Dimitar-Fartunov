@using BlazorApp1.Components.Services
@inject AuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<nav class="navbar">
    <div class="nav-container">
        <a href="/" class="nav-brand">Game Recommender</a>

        <div class="nav-links">
            <a href="/" class="nav-link">Home</a>

            @if (AuthService.IsAuthenticated)
            {
                <a href="/wishlist" class="nav-link">❤️ Wishlist</a>
                <span class="nav-user">👤 @AuthService.CurrentUser?.Username</span>
                <button @onclick="HandleLogout" class="nav-btn">Logout</button>
            }
            else
            {
                <a href="/login" class="nav-link">Login</a>
                <a href="/register" class="nav-btn-link">Register</a>
            }
        </div>
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}